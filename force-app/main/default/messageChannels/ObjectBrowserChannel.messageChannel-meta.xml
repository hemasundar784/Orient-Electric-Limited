<?xml version="1.0" encoding="UTF-8"?>
<LightningMessageChannel xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>Object Browser Channel</masterLabel>
    <isExposed>true</isExposed>
    <description>Coordinates object selection and record selection between LWCs</description>
    <lightningMessageFields>
        <fieldName>action</fieldName>
        <description>Type of event (OBJECT_SELECTED, RECORD_SELECTED)</description>
    </lightningMessageFields>
    <lightningMessageFields>
        <fieldName>objectApiName</fieldName>
        <description>API name of the sObject</description>
    </lightningMessageFields>
    <lightningMessageFields>
        <fieldName>recordId</fieldName>
        <description>Id of selected record (for record viewer)</description>
    </lightningMessageFields>
</LightningMessageChannel>
