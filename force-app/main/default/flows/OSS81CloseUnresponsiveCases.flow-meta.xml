                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_to_Contact</targetReference>
            </connector>
            <label>Contact Found</label>
        </rules>
    </decisions>
