            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>SalesOrdertype</name>
        <label>Sales Order type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.RecordTypeId</assignToReference>
            <operator>Assign</operator>
            <value>
